{
  "$ref": "#/definitions/projects",
  "definitions": {
    "projects": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "pubDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "year": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "stack": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "demo": {
          "type": "string"
        },
        "repo": {
          "type": "string",
          "format": "uri"
        },
        "cover": {
          "type": "string"
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "order": {
          "type": "number",
          "default": 0
        },
        "category": {
          "type": "string",
          "enum": [
            "engineering",
            "studio"
          ],
          "default": "engineering"
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "summary",
        "pubDate"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}