---
import BaseLayout from '../layouts/BaseLayout.astro';

const channels = [
  {
    title: '邮箱',
    icon: '✉',
    primary: '2047441719hg@gmail.com',
    note: '最直接的方式。看到会回。',
    href: 'mailto:2047441719hg@gmail.com',
    featured: true,
  },
  {
    title: 'GitHub',
    icon: '⌘',
    primary: 'github.com/jordan-home',
    note: '代码、issue、合作。',
    href: 'https://github.com/jordan-home',
  },
  {
    title: '微信',
    icon: '微信',
    primary: 'Mr_Jordan-H',
    note: '日常联络。',
    href: '#',
  },
];
---

<BaseLayout title="联系 · Jordan の Words" description="联系 Jordan — 合作、约稿、随便聊聊">
  <section class="contact container">
    <p class="contact__kicker deco">· 卷 · 末 ·</p>
    <h1 class="contact__title">写信给我</h1>
    <p class="contact__lede">
      合作、约稿、随便聊聊——都欢迎。<br />
      看到会回，请放心发。
    </p>

    <div class="channels">
      {channels.map((ch, i) => (
        <a href={ch.href}
           class:list={["channel reveal", ch.featured && "channel--featured"]}
           style={`animation-delay: ${i * 80}ms`}
           target={ch.href.startsWith('http') ? '_blank' : undefined}
           rel={ch.href.startsWith('http') ? 'noopener' : undefined}>
          <span class="channel__icon deco">{ch.icon}</span>
          <div class="channel__body">
            <h2 class="channel__title">{ch.title}</h2>
            <p class="channel__primary">{ch.primary}</p>
            <p class="channel__note fade">{ch.note}</p>
          </div>
          <span class="channel__arrow">→</span>
        </a>
      ))}
    </div>

    <section class="hint">
      <p>📮 <strong>小提示</strong>：发邮件时如果有具体需求，附上一两句话说明 —— 是合作 / 约稿 / 聊某个话题 / 还是只想问个问题 —— 我好更快回应。</p>
      <ul>
        <li>合作 / 咨询：3 个工作日内回复</li>
        <li>个人闲聊：随时都行，但我回得慢</li>
        <li>邮件主题写清楚 — 别发空主题邮件</li>
      </ul>
    </section>
  </section>
</BaseLayout>

<style>
  .contact { padding: var(--sp-9) 0 var(--sp-9); text-align: center; }

  .contact__kicker { margin: 0 0 var(--sp-4); font-size: var(--fs-md); }
  .contact__title { font-size: var(--fs-3xl); margin: 0 0 var(--sp-5); }
  .contact__lede {
    font-size: var(--fs-md);
    color: var(--ink-soft);
    line-height: var(--lh-loose);
    margin: 0 auto var(--sp-8);
    max-width: 32em;
  }

  .channels {
    display: grid;
    gap: var(--sp-4);
    text-align: left;
    max-width: 48rem;
    margin: 0 auto;
  }

  .channel {
    display: grid;
    grid-template-columns: 60px 1fr 30px;
    align-items: center;
    gap: var(--sp-5);
    padding: var(--sp-5) var(--sp-6);
    background: var(--paper-warm);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    color: var(--ink);
    transition: all var(--dur-fast) var(--ease-soft);
  }
  .channel:hover {
    background: var(--paper);
    border-color: var(--cinnabar);
    transform: translateX(4px);
  }
  .channel--featured {
    background: linear-gradient(135deg, var(--paper-warm), var(--paper));
    border-color: var(--cinnabar);
    box-shadow: var(--sh-1);
  }
  .channel__icon {
    font-size: 2.5rem;
    color: var(--cinnabar);
    text-align: center;
    font-family: var(--font-serif-cn);
  }
  .channel__body { min-width: 0; }
  .channel__title {
    font-size: var(--fs-lg);
    margin: 0 0 var(--sp-2);
    font-weight: 500;
  }
  .channel__primary {
    margin: 0 0 var(--sp-1);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--ink);
    word-break: break-all;
  }
  .channel__note {
    margin: 0;
    font-size: var(--fs-xs);
  }
  .channel__arrow {
    color: var(--ink-fade);
    font-size: 1.5rem;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .channel:hover .channel__arrow {
    transform: translateX(4px);
    color: var(--cinnabar);
  }

  .hint {
    margin-top: var(--sp-9);
    padding: var(--sp-5) var(--sp-6);
    background: var(--paper-warm);
    border-radius: var(--r-md);
    text-align: left;
    max-width: 48rem;
    margin-inline: auto;
  }
  .hint p { margin: 0 0 var(--sp-3); font-size: var(--fs-sm); color: var(--ink-soft); }
  .hint ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--ink-soft);
  }
  .hint ul li {
    padding: var(--sp-1) 0 var(--sp-1) var(--sp-4);
    position: relative;
  }
  .hint ul li::before {
    content: '·';
    position: absolute;
    left: var(--sp-2);
    color: var(--cinnabar);
  }

  @media (max-width: 860px) {
    .contact { padding: var(--sp-7) 0 var(--sp-8); }
    .contact__title { font-size: var(--fs-2xl); }
  }
  @media (max-width: 640px) {
    .contact__title { font-size: var(--fs-xl); }
    .channel { padding: var(--sp-4); gap: var(--sp-3); }
    .channel__icon { font-size: 2rem; }
    .channel__title { font-size: var(--fs-base); }
    .hint { padding: var(--sp-4); margin-top: var(--sp-7); }
  }
  @media (max-width: 480px) {
    .contact { padding: var(--sp-6) 0 var(--sp-7); }
    .channel { grid-template-columns: 40px 1fr; padding: var(--sp-3) var(--sp-4); }
    .channel__icon { font-size: 1.6rem; }
    .channel__arrow { display: none; }
    .channel__primary { font-size: var(--fs-xs); }
    .contact__lede { font-size: var(--fs-base); }
    .contact__title { font-size: var(--fs-lg); }
  }
</style>