---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const categoryLabels: Record<string, string> = {
  technology: '技术', note: '心理', health: '健康',
  lifes: '生活', projects: '作品', literature: '文学',
  philosophy: '哲学', misc: '随笔',
};

const dateFmt = post.data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric', month: 'long', day: 'numeric'
});

// 上下篇
const allPosts = (await getCollection('posts'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const idx = allPosts.findIndex(p => p.id === post.id);
const prev = idx < allPosts.length - 1 ? allPosts[idx + 1] : null;
const next = idx > 0 ? allPosts[idx - 1] : null;
---

<BaseLayout title={`${post.data.title} · Jordan の Words`}
            description={post.data.description}>

  <article class="post">
    <header class="post__head container">
      <p class="post__meta">
        <span class="post__cat">{categoryLabels[post.data.category]}</span>
        <time datetime={post.data.pubDate.toISOString()}>{dateFmt}</time>
      </p>
      <h1 class="post__title">{post.data.title}</h1>
      {post.data.description && (
        <p class="post__desc deco">{post.data.description}</p>
      )}
      <hr class="post__rule" />
    </header>

    <div class="post__body prose-container prose">
      <Content />
    </div>

    {post.data.tags.length > 0 && (
      <footer class="post__tags prose-container">
        {post.data.tags.map(t => <span class="tag">#{t}</span>)}
      </footer>
    )}
  </article>

  <nav class="post-nav container">
    {prev && (
      <a href={`/posts/${prev.id}`} class="post-nav__link post-nav__link--prev">
        <span class="post-nav__kicker">← 上一篇</span>
        <span class="post-nav__title">{prev.data.title}</span>
      </a>
    )}
    {next && (
      <a href={`/posts/${next.id}`} class="post-nav__link post-nav__link--next">
        <span class="post-nav__kicker">下一篇 →</span>
        <span class="post-nav__title">{next.data.title}</span>
      </a>
    )}
  </nav>
</BaseLayout>

<style>
  .post { padding: var(--sp-8) 0; }
  .post__head { text-align: center; margin-bottom: var(--sp-7); }
  .post__meta {
    display: flex;
    gap: var(--sp-4);
    justify-content: center;
    font-size: var(--fs-xs);
    color: var(--ink-fade);
    margin: 0 0 var(--sp-5);
  }
  .post__cat {
    padding: 2px 10px;
    background: var(--cinnabar);
    color: var(--paper);
    border-radius: var(--r-sm);
  }
  .post__title {
    font-size: var(--fs-3xl);
    margin: 0 0 var(--sp-4);
    line-height: var(--lh-snug);
  }
  .post__desc {
    font-size: var(--fs-md);
    color: var(--ink-soft);
    line-height: var(--lh-loose);
    margin: 0 0 var(--sp-5);
    font-style: italic;
  }
  .post__rule {
    width: 80px;
    height: 28px;
    border: 0;
    background: url('/illustrations/divider-bamboo.svg') no-repeat center / contain;
    margin: var(--sp-6) auto 0;
  }

  .post__tags {
    margin-top: var(--sp-7);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .post__tags .tag {
    font-size: var(--fs-xs);
    padding: 4px 12px;
    background: var(--paper-warm);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    color: var(--ink-soft);
  }

  /* —— 上下篇 —— */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4);
    margin-top: var(--sp-7);
    padding-top: var(--sp-7);
    border-top: 1px solid var(--line);
  }
  .post-nav__link {
    display: block;
    padding: var(--sp-4);
    background: var(--paper-warm);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    color: var(--ink);
    transition: all var(--dur-fast) var(--ease-soft);
  }
  .post-nav__link:hover {
    border-color: var(--cinnabar);
    background: var(--paper);
  }
  .post-nav__link--next { text-align: right; }
  .post-nav__kicker {
    display: block;
    font-size: var(--fs-xs);
    color: var(--ink-fade);
    margin-bottom: var(--sp-2);
  }
  .post-nav__title {
    display: block;
    font-size: var(--fs-base);
    font-weight: 500;
  }

  @media (max-width: 860px) {
    .post__title { font-size: var(--fs-2xl); }
    .post__body :global(h2) { font-size: var(--fs-lg); }
    .post__body :global(h3) { font-size: var(--fs-md); }
    .post__desc { font-size: var(--fs-base); }
  }
  @media (max-width: 640px) {
    .post { padding: var(--sp-6) 0; }
    .post__head { margin-bottom: var(--sp-5); }
    .post__title { font-size: var(--fs-xl); }
    .post__meta { flex-wrap: wrap; gap: var(--sp-2); }
    .post-nav { grid-template-columns: 1fr; }
    .post__body :global(pre) { font-size: var(--fs-xs); padding: var(--sp-4); }
  }
  @media (max-width: 480px) {
    .post__title { font-size: var(--fs-lg); }
    .post__rule { width: 60px; height: 20px; margin-top: var(--sp-5); }
    .post__body :global(blockquote) { padding: var(--sp-3) var(--sp-4); }
  }
</style>